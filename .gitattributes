# Markdown uses two trailing spaces for intentional hard line breaks.
*.md whitespace=-trailing-space

# Keep source and configuration files normalized across platforms.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Preserve the validated candidate byte-for-byte while still checking source
# trailing spaces; several legacy files intentionally contain a final blank line.
*.ts whitespace=-blank-at-eof
*.tsx whitespace=-blank-at-eof
*.js whitespace=-blank-at-eof
*.mjs whitespace=-blank-at-eof
*.vue whitespace=-blank-at-eof

# These validated generator sources contain intentional Markdown/template
# trailing spaces; keep their candidate bytes unchanged.
scripts/grok-mvp-authority-bind-freeze.mjs whitespace=-trailing-space
scripts/validate-p8-production-dashboard-final.ts whitespace=-trailing-space
